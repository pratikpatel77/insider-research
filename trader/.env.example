# Copy this file to ".env" (same folder) and fill in ONLY the broker you use. Never commit or share ".env".
# Paper trading needs none of this.

# --- Live trading is locked until you add this line (and restart). Leave it out while testing. ---
# TRADER_ALLOW_LIVE=1

# --- Definedge Securities (Integrate API) ---
DEFINEDGE_API_TOKEN=
DEFINEDGE_API_SECRET=
DEFINEDGE_TOTP_SECRET=
# Mandatory for API orders since 31 Mar 2026 (SEBI): the algo id your broker gave you
DEFINEDGE_ALGO_ID=

# --- Kotak Neo ---
KOTAK_NEO_CONSUMER_KEY=
KOTAK_NEO_MOBILE_NUMBER=
KOTAK_NEO_UCC=
KOTAK_NEO_MPIN=
# Optional: with the TOTP seed the daily login is automatic; without it you type the 6-digit code in the dashboard
KOTAK_NEO_TOTP_SECRET=
KOTAK_NEO_ENV=prod

# --- Fyers (browser login each morning from the dashboard) ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=

# --- Optional: Telegram alerts for buys, exits and warnings ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
